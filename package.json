{
  "name": "stanza",
  "version": "0.1.0",
  "description": "A desktop wrapper for Claude Code: project sidebar, tabs, git status and a running-servers panel.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test",
    "package": "node scripts/rename-handoff.js before && electron-builder --win dir && node scripts/rename-handoff.js after",
    "package:mac": "node scripts/rename-handoff.js before && electron-builder --mac dir -c.extraMetadata.stanzaRepo=\"$PWD\" && node scripts/rename-handoff.js after",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "com.local.stanza",
    "productName": "Stanza",
    "directories": { "output": "dist" },
    "files": ["src/**", "assets/**", "package.json"],
    "asarUnpack": ["node_modules/@lydell/**"],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["dir"]
    },
    "mac": {
      "icon": "assets/icon-mac.png",
      "target": ["dir"],
      "category": "public.app-category.developer-tools"
    }
  }
}
